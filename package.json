{
  "name": "windows95-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows 95 desktop recreated in the browser with JavaScript ES modules, HTML and CSS",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "serve": "python3 -m http.server 8080 --directory src",
    "build": "node tools/build-site.mjs --source src --output _site",
    "test": "node --test tests/*.test.mjs"
  }
}
